<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/chip_corner_radius" />
            <solid android:color="@color/emergency_red_subtle" />
            <stroke
                android:width="1.5dp"
                android:color="@color/emergency_red" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/chip_corner_radius" />
            <solid android:color="@color/emergency_red_subtle" />
            <stroke
                android:width="1.5dp"
                android:color="@color/emergency_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/chip_corner_radius" />
            <solid android:color="@color/bg_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
