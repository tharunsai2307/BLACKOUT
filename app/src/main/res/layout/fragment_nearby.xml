<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xxxlarge">

        <!-- Screen Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nearby_screen_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <!-- Protocol & Store-and-Forward Explanation Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BLACKOUT.Card.Teal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_broadcast"
                        app:tint="@color/teal_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/nearby_protocol_title"
                        android:textColor="@color/teal_accent"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/nearby_protocol_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Local Node Identity Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/teal_accent" />

                <TextView
                    android:id="@+id/tv_nearby_my_identity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    tools:text="Local Node: NODE-7F84 (DEV-7F841234)" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Discovery Status & Controls Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_nearby_status_dot"
                        android:layout_width="@dimen/status_dot_size"
                        android:layout_height="@dimen/status_dot_size"
                        android:background="@drawable/bg_status_dot_offline" />

                    <TextView
                        android:id="@+id/tv_nearby_radio_state"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/nearby_radio_state_idle"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_nearby_status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_neutral"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingTop="@dimen/spacing_xsmall"
                        android:paddingEnd="@dimen/spacing_small"
                        android:paddingBottom="@dimen/spacing_xsmall"
                        android:text="@string/nearby_badge_idle"
                        android:textColor="@color/status_offline"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_nearby_discovery_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/nearby_radio_state_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <!-- Action Controls: Advertise, Discover, Stop -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nearby_advertise"
                        style="@style/Widget.BLACKOUT.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginEnd="@dimen/spacing_xsmall"
                        android:layout_weight="1"
                        android:text="@string/nearby_btn_start_advertising"
                        android:textSize="@dimen/text_size_caption"
                        app:icon="@drawable/ic_broadcast"
                        app:iconSize="@dimen/icon_size_xsmall"
                        app:iconTint="@color/bg_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nearby_discover"
                        style="@style/Widget.BLACKOUT.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginStart="@dimen/spacing_xsmall"
                        android:layout_marginEnd="@dimen/spacing_xsmall"
                        android:layout_weight="1"
                        android:text="@string/nearby_btn_start_discovery"
                        android:textSize="@dimen/text_size_caption"
                        app:icon="@drawable/ic_radar"
                        app:iconSize="@dimen/icon_size_xsmall"
                        app:iconTint="@color/teal_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nearby_stop"
                        style="@style/Widget.BLACKOUT.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginStart="@dimen/spacing_xsmall"
                        android:enabled="false"
                        android:text="@string/nearby_btn_stop_radio"
                        android:textSize="@dimen/text_size_caption"
                        app:icon="@drawable/ic_signal_disconnected"
                        app:iconSize="@dimen/icon_size_xsmall"
                        app:iconTint="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Connection Request Approval Card (Initially GONE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_approval"
            style="@style/Widget.BLACKOUT.Card.Emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nearby_approval_title"
                    android:textColor="@color/emergency_red"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nearby_approval_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large"
                    android:textStyle="bold"
                    tools:text="Peer: NODE-4A12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="@string/nearby_approval_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tv_nearby_auth_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="@drawable/bg_card_inner"
                    android:fontFamily="monospace"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_small"
                    android:textColor="@color/teal_accent"
                    android:textSize="@dimen/text_size_body_large"
                    android:textStyle="bold"
                    tools:text="Verification Code: 8392" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nearby_accept"
                        style="@style/Widget.BLACKOUT.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/nearby_btn_accept"
                        app:icon="@drawable/ic_check_circle"
                        app:iconTint="@color/bg_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_nearby_reject"
                        style="@style/Widget.BLACKOUT.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/nearby_btn_reject"
                        app:icon="@drawable/ic_signal_disconnected"
                        app:iconTint="@color/emergency_red" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Active Connected Peer Card (Initially GONE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_connected"
            style="@style/Widget.BLACKOUT.Card.Teal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_radio_mesh"
                        app:tint="@color/teal_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/nearby_connected_card_title"
                        android:textColor="@color/teal_accent"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/spacing_small"
                        android:paddingBottom="2dp"
                        android:text="ONLINE"
                        android:textColor="@color/status_success"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_nearby_connected_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold"
                    tools:text="NODE-B234" />

                <TextView
                    android:id="@+id/tv_nearby_connected_endpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_size_caption"
                    tools:text="Endpoint ID: 4xF9 • Direct P2P Radio Link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nearby_disconnect"
                    style="@style/Widget.BLACKOUT.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/nearby_btn_disconnect"
                    app:icon="@drawable/ic_signal_disconnected"
                    app:iconTint="@color/status_warning" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Store-Carry-and-Forward Relay Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_relay_status"
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_broadcast"
                        app:tint="@color/teal_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/nearby_relay_title"
                        android:textColor="@color/teal_accent"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_relay_queue_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/spacing_small"
                        android:paddingBottom="2dp"
                        android:textColor="@color/teal_accent"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        tools:text="0 QUEUED" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_relay_status_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/nearby_relay_desc_default"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Internet Gateway & Cloud Synchronization Card (Phase 5) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_gateway"
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_radar"
                        app:tint="@color/teal_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="Internet Gateway &amp; Cloud Sync"
                        android:textColor="@color/teal_accent"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_gateway_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_neutral"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/spacing_small"
                        android:paddingBottom="2dp"
                        android:textColor="@color/status_offline"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        android:text="OFFLINE" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_gateway_status_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="2dp"
                    android:text="Internet connection unavailable. Emergency SOS messages remain securely buffered locally."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />

                <!-- Sync Now Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gateway_sync_now"
                    style="@style/Widget.BLACKOUT.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="Sync Pending Alerts Now"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/teal_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Direct SOS Transfer Section (Visible when Connected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_transfer"
            style="@style/Widget.BLACKOUT.Card.Emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sos"
                        app:tint="@color/emergency_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/nearby_transfer_section_title"
                        android:textColor="@color/emergency_red"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/nearby_transfer_select_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <!-- Select SOS Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nearby_select_sos"
                    style="@style/Widget.BLACKOUT.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/nearby_transfer_btn_select"
                    app:icon="@drawable/ic_nav_history"
                    app:iconTint="@color/teal_accent" />

                <!-- Selected SOS Preview Container (Initially GONE) -->
                <LinearLayout
                    android:id="@+id/layout_nearby_selected_sos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_inner"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_nearby_selected_priority"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_emergency"
                            android:paddingStart="@dimen/spacing_small"
                            android:paddingTop="2dp"
                            android:paddingEnd="@dimen/spacing_small"
                            android:paddingBottom="2dp"
                            android:textColor="@color/emergency_red"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            tools:text="CRITICAL" />

                        <TextView
                            android:id="@+id/tv_nearby_selected_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="@dimen/spacing_small"
                            android:paddingTop="2dp"
                            android:paddingEnd="@dimen/spacing_small"
                            android:paddingBottom="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            tools:text="MEDICAL EMERGENCY" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_nearby_selected_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="Heart condition reported. Needs oxygen." />

                    <TextView
                        android:id="@+id/tv_nearby_selected_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        tools:text="Lat: 37.77490° N, Lon: -122.41940° E (±5.2m)" />

                </LinearLayout>

                <!-- Transmit Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nearby_send_sos"
                    style="@style/Widget.BLACKOUT.Button.Emergency"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sos_button_height"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:enabled="false"
                    android:text="@string/nearby_transfer_btn_send"
                    app:icon="@drawable/ic_broadcast"
                    app:iconTint="@color/white" />

                <!-- Transfer Status / Progress -->
                <LinearLayout
                    android:id="@+id/layout_nearby_transfer_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pb_nearby_transfer"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/teal_accent" />

                    <TextView
                        android:id="@+id/tv_nearby_transfer_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body_small"
                        tools:text="Transmitting payload to peer..." />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Nearby Detected Nodes Section -->
        <TextView
            android:id="@+id/tv_nearby_detected_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/nearby_detected_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <!-- Discovered Devices RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_nearby_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <!-- Empty State Card for Discovered Nodes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nearby_empty_devices"
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xlarge">

                <ImageView
                    android:layout_width="@dimen/icon_size_hero"
                    android:layout_height="@dimen/icon_size_hero"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_nearby"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/nearby_detected_empty"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="300dp"
                    android:text="@string/nearby_detected_explanation"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
