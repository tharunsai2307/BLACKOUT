<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xxxlarge">

        <!-- Header: Back Button & Screen Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_sos_back"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_close"
                android:focusable="true"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="1"
                android:text="@string/sos_screen_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <!-- Emergency Priority Badge Indicator -->
            <TextView
                android:id="@+id/tv_sos_header_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_emergency"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_xsmall"
                tools:text="CRITICAL"
                android:textColor="@color/emergency_red"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Phase 2 Architecture Notice Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BLACKOUT.Card.Emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/emergency_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/sos_phase_notice_title"
                        android:textColor="@color/emergency_red"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/sos_phase_notice_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 8 Emergency Categories Selector Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/sos_category_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_medical"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/sos_category_medical"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_medical"
                app:chipIconTint="@color/emergency_red" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_accident"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_road_accident"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_accident"
                app:chipIconTint="@color/status_warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_trapped"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_trapped"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_stranded"
                app:chipIconTint="@color/status_warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_flood"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_flood"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_flood"
                app:chipIconTint="@color/status_warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fire"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_fire"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_fire"
                app:chipIconTint="@color/emergency_red" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_disaster"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_disaster"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_disaster"
                app:chipIconTint="@color/emergency_red" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_personal_safety"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_personal_safety"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_personal_safety"
                app:chipIconTint="@color/status_warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_other"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_category_other"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@drawable/bg_chip_category"
                app:chipIcon="@drawable/ic_other"
                app:chipIconTint="@color/teal_accent" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Priority Indicator Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/sos_priority_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <ImageView
                    android:id="@+id/iv_priority_icon"
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_priority_high"
                    app:tint="@color/emergency_red" />

                <TextView
                    android:id="@+id/tv_priority_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:text="@string/sos_priority_critical"
                    android:textColor="@color/emergency_red"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency Situation Description Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/sos_details_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_sos_description"
            style="@style/Widget.BLACKOUT.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sos_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/sos_details_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:maxLines="6"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- GPS Location Information Section (Phase 2 Real Hardware GPS) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/sos_location_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sos_location"
            style="@style/Widget.BLACKOUT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <!-- Location Status Line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_sos_location_icon"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/teal_accent" />

                    <TextView
                        android:id="@+id/tv_sos_location_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:text="@string/loc_status_unavailable"
                        android:textColor="@color/status_warning"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <!-- Indeterminate ProgressBar for GPS acquisition -->
                    <ProgressBar
                        android:id="@+id/pb_sos_location"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/teal_accent"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Coordinates Details Container -->
                <LinearLayout
                    android:id="@+id/layout_sos_coords_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_inner"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/tv_sos_coordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/sos_coords_none"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tv_sos_accuracy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        tools:text="Accuracy: ±5.2 metres"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_sos_timestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        tools:text="Fix Time: 23:45:12"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/sos_location_explanation"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />

                <!-- Location Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_get_location"
                    style="@style/Widget.BLACKOUT.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/sos_btn_get_location"
                    app:icon="@drawable/ic_location_pin"
                    app:iconTint="@color/teal_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Final Action Button: Create / Save Emergency SOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sos_prepare"
            style="@style/Widget.BLACKOUT.Button.Emergency"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sos_button_height"
            android:layout_marginTop="@dimen/spacing_xxlarge"
            android:text="@string/sos_action_create"
            app:icon="@drawable/ic_sos"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
