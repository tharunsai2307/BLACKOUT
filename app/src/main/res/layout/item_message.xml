<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_message_root"
    style="@style/Widget.BLACKOUT.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Top Row: Priority & Status Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_priority_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_emergency"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_xsmall"
                tools:text="CRITICAL"
                android:textColor="@color/emergency_red"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_badge_neutral"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_xsmall"
                tools:text="MEDICAL"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_teal"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_xsmall"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_xsmall"
                tools:text="PENDING RELAY"
                android:textColor="@color/teal_accent"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Message Body -->
        <TextView
            android:id="@+id/tv_message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingExtra="3dp"
            tools:text="Emergency situation details..."
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large" />

        <!-- Location Info (Always displayed: Coordinates or Unavailable) -->
        <LinearLayout
            android:id="@+id/layout_message_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_message_location_icon"
                android:layout_width="@dimen/icon_size_xsmall"
                android:layout_height="@dimen/icon_size_xsmall"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_message_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xsmall"
                tools:text="Coords: 37.7749° N, 122.4194° W"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@color/divider_color" />

        <!-- Bottom Footer Row: Sender ID & Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_xsmall"
                android:layout_height="@dimen/icon_size_xsmall"
                android:contentDescription="@null"
                android:src="@drawable/ic_time"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xsmall"
                tools:text="2 mins ago"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_sender_callsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Sender: NODE-7F84 (Local)"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
