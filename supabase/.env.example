# BLACKOUT Supabase Edge Functions Environment Configuration
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL

# Core Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS Gateway Provider Configuration
# Set these to enable live Twilio SMS notifications for emergency contacts and dispatch
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_FROM_NUMBER=+15551234567

# Generic Webhook SMS Gateway (Alternative Provider)
# SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send
# SMS_GATEWAY_API_KEY=your_webhook_api_key

# Geoapify Geocoding Configuration
GEOAPIFY_API_KEY=your_geoapify_api_key
